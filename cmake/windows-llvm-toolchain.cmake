set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
get_filename_component(_repo "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(LLVM_MINGW_ROOT "${_repo}/deps/llvm-mingw-20260616-ucrt-x86_64" CACHE PATH "Native Windows LLVM-MinGW toolchain")
set(CMAKE_C_COMPILER "${LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang.exe")
set(CMAKE_CXX_COMPILER "${LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang++.exe")
set(CMAKE_RC_COMPILER "${LLVM_MINGW_ROOT}/bin/x86_64-w64-mingw32-windres.exe")
set(CMAKE_C_FLAGS_INIT "-fms-extensions")
set(CMAKE_CXX_FLAGS_INIT "-fms-extensions")
# Keep the plugin and native test executables independent of compiler DLLs.
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-static")
set(D2RL_SDK "${_repo}/deps/D2RLoader-PluginSDK" CACHE PATH "Pinned D2RLoader SDK")
set(OPENXR_SDK "${_repo}/deps/OpenXR-SDK" CACHE PATH "Pinned OpenXR SDK")
set(BOX3D_SDK "${_repo}/deps/box3d" CACHE PATH "Pinned Box3D")
