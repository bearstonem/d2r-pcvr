# build output
/build/
# read-only memory snapshots of the game (tens of MB, Blizzard's code)
/dump/
/dump_ingame/
/dump_loader/
# their own git repositories
/D2R-3D/
/PluginSDK/
# raw sky renders; the finished textures are kept
/reshade/sky/raw/
*.bak*
__pycache__/

# taken out of the game's archives (Blizzard's art, this machine only) and the tool's own build
# extracted/blizzard/ - the game's own files; the rest - our OpenAI drawings
/extracted/
/third_party/CascLib/
/tools/casc_extract/build/

# the installer's staging and its output
/installer/payload/
/installer/Output/

# Blizzard's own files, wherever they turn up: the game's formats, and the skies
# taken from its menus (kept on this machine, never published - 2026-10-05)
*.texture
*.model
*.pvr
*.dds
*_game.png
*_menu.png
*_storm.png
/build_public/
promo/

/build-frame/
# Downloaded dependencies and extracted preview payloads stay local.
/deps/
/bin/
/release-manifest.json
/.runtime/
/setup-backups/
/setup-result.json
/openxr-probe-result.txt
# Native asset caches are generated separately from each user's own installation.
**/d2r_vr_icons/
**/d2r_vr_potions/
/vkd3d-proton.cache*
# The main menu's 3D scenes on this machine: which test models hold our floors (prepare_frontend_floor.py writes it
# from each player's own game), the game models it read, the owner's backups of the scene plans
/steamvr/frontend_floors.json
/steamvr/_cut_sources/
/steamvr/frontend_edits_act* - *.json
/steamvr/frontend_edits_act* — *.json
